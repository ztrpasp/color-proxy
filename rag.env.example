# Copy this file to rag.env (repository root). Never commit a real DeepSeek API key or DB password.

# ---- MySQL 8.x -------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=colorproxy
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=colorproxy_rag
MYSQL_POOL_SIZE=4
MYSQL_CONNECT_TIMEOUT=5

# ---- DeepSeek --------------------------------------------------------------
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# disabled is recommended for this RAG demo: lower TTFT/cost and no local GPU is involved.
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=900
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_TEMPERATURE=0.25

# ---- Retrieval -------------------------------------------------------------
RAG_TOP_K=6
RAG_CANDIDATE_K=14
RAG_MAX_CONTEXT_CHARS=10000
RAG_CHUNK_CHARS=1100
RAG_CHUNK_OVERLAP_CHARS=140

# ---- Minimal Provider P2/P3 -----------------------------------------------
# Optional. Relative paths are resolved from the process working directory.
# When omitted, provider-policy.json at the repository root is used.
# PROVIDER_POLICY_FILE=provider-policy.json
# Requester identity (which policy entry applies) is NOT read from any request header.
# Under L3 the origin maps the TCP peer address (the consumer's tun IP) to its NID via
# config.json l3.peers[]; see docs/RESTFUL-L3.md.
